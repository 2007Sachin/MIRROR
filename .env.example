# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# API runtime
ENVIRONMENT=development
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
RESUME_MAX_FILE_SIZE_BYTES=8388608

# LLM / agent providers (server only)
INTERVIEWER_MODEL=sarvam-105b-conversations
SKEPTIC_MODEL=sarvam-105b-conversations
ASSESSOR_MODEL=sarvam-105b-conversations
BATCH_MODEL=sarvam-105b-conversations

# Voice providers (server only)
# Transcription vendor: "deepgram" (default) or "sarvam" to run voice in and
# out on Sarvam alone, in which case DEEPGRAM_API_KEY is not needed.
SPEECH_TO_TEXT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# Leave blank to let Sarvam auto-detect the spoken language.
SARVAM_STT_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=priya
SARVAM_TTS_OUTPUT_CODEC=mp3
INTERVIEW_TTS_LANGUAGE=en-IN
INTERVIEW_AUDIO_MAX_FILE_SIZE_BYTES=10485760
INTERVIEW_AUDIO_MIN_DURATION_MS=300

# Interview and worker tuning
INTERVIEW_DEFAULT_DURATION_SECONDS=1200
INTERVIEW_PHASE_TIME_BUDGET_SECONDS=180
SKEPTIC_SHADOW_MODE=true
LIVE_SKEPTIC_PROBES=false
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only settings
SUPABASE_SERVICE_ROLE_KEY=
RESUME_MAX_FILE_SIZE_BYTES=8388608
NEXT_PUBLIC_RESUME_MAX_FILE_SIZE_BYTES=8388608
# Transcription vendor: "deepgram" (default) or "sarvam" to run voice in and
# out on Sarvam alone, in which case DEEPGRAM_API_KEY is not needed.
SPEECH_TO_TEXT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# Leave blank to let Sarvam auto-detect the spoken language.
SARVAM_STT_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=priya
SARVAM_TTS_OUTPUT_CODEC=mp3
INTERVIEW_TTS_LANGUAGE=en-IN
INTERVIEW_AUDIO_MAX_FILE_SIZE_BYTES=10485760
INTERVIEW_AUDIO_MIN_DURATION_MS=300
INTERVIEW_AUDIO_SIGNED_URL_SECONDS=300
INTERVIEW_MIN_TRANSCRIPT_CONFIDENCE=0.2
INTERVIEWER_MODEL=sarvam-105b-conversations
SKEPTIC_MODEL=sarvam-105b-conversations
SKEPTIC_SHADOW_MODE=true
LIVE_SKEPTIC_PROBES=false
SKEPTIC_LIVE_PROBE_MIN_CONFIDENCE=0.8
SKEPTIC_JOB_MAX_ATTEMPTS=3
SKEPTIC_JOB_RETRY_BASE_SECONDS=15
ASSESSOR_MODEL=sarvam-105b-conversations
BATCH_MODEL=sarvam-105b-conversations
APP_URL=http://localhost:3000
ENVIRONMENT=development
SKEPTIC_MODE=shadow
INTERVIEW_DEFAULT_DURATION_SECONDS=1200
INTERVIEW_PHASE_TIME_BUDGET_SECONDS=180
PLANNER_INTRO_RESERVE_SECONDS=60
PLANNER_TRANSITION_RESERVE_SECONDS=60
PLANNER_CLOSING_RESERVE_SECONDS=60

# Voice latency (see docs/voice/CONTRACT.md). Set to false to return to the original path.
VOICE_HTTP_POOL=false
VOICE_PARALLEL_CONTEXT=false
VOICE_ASYNC_PERSIST=false
VOICE_STREAMING_STT=false
VOICE_SESSION_CACHE=false

# How long a student can stay quiet before an answer counts as finished (milliseconds)
NEXT_PUBLIC_VOICE_SILENCE_MS=2500

# Liveness: one live tab per conversation; auto-pause after this many quiet seconds.
SESSION_LEASE_SECONDS=30
SESSION_IDLE_PAUSE_SECONDS=90
