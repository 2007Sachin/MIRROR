# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# API runtime
ENVIRONMENT=development
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
RESUME_MAX_FILE_SIZE_BYTES=8388608

# LLM / agent providers (server only)
GROQ_API_KEY=
INTERVIEWER_MODEL=llama-3.1-8b-instant
SKEPTIC_MODEL=llama-3.3-70b-versatile
ASSESSOR_MODEL=llama-3.3-70b-versatile
BATCH_MODEL=llama-3.3-70b-versatile

# Voice providers (server only)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE=anushka
INTERVIEW_TTS_LANGUAGE=en-IN
INTERVIEW_AUDIO_MAX_FILE_SIZE_BYTES=10485760
INTERVIEW_AUDIO_MIN_DURATION_MS=300

# Interview and worker tuning
INTERVIEW_DEFAULT_DURATION_SECONDS=1200
INTERVIEW_PHASE_TIME_BUDGET_SECONDS=180
SKEPTIC_SHADOW_MODE=true
LIVE_SKEPTIC_PROBES=false
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only settings
SUPABASE_SERVICE_ROLE_KEY=
RESUME_MAX_FILE_SIZE_BYTES=8388608
NEXT_PUBLIC_RESUME_MAX_FILE_SIZE_BYTES=8388608
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE=anushka
INTERVIEW_TTS_LANGUAGE=en-IN
INTERVIEW_AUDIO_MAX_FILE_SIZE_BYTES=10485760
INTERVIEW_AUDIO_MIN_DURATION_MS=300
INTERVIEW_AUDIO_SIGNED_URL_SECONDS=300
INTERVIEW_MIN_TRANSCRIPT_CONFIDENCE=0.2
GROQ_API_KEY=
INTERVIEWER_MODEL=llama-3.1-8b-instant
SKEPTIC_MODEL=llama-3.3-70b-versatile
SKEPTIC_SHADOW_MODE=true
LIVE_SKEPTIC_PROBES=false
SKEPTIC_LIVE_PROBE_MIN_CONFIDENCE=0.8
SKEPTIC_JOB_MAX_ATTEMPTS=3
SKEPTIC_JOB_RETRY_BASE_SECONDS=15
ASSESSOR_MODEL=llama-3.3-70b-versatile
BATCH_MODEL=llama-3.3-70b-versatile
APP_URL=http://localhost:3000
ENVIRONMENT=development
SKEPTIC_MODE=shadow
INTERVIEW_DEFAULT_DURATION_SECONDS=1200
INTERVIEW_PHASE_TIME_BUDGET_SECONDS=180
PLANNER_INTRO_RESERVE_SECONDS=60
PLANNER_TRANSITION_RESERVE_SECONDS=60
PLANNER_CLOSING_RESERVE_SECONDS=60

